# Anthropic (Claude) — usado por agente_demo.js, build_flow2.js, build_agente.js y flow2_agente_configurable.json
ANTHROPIC_API_KEY=sk-ant-...

# Twilio — usado por build_flow2.js, build_agente.js y los flows que envían/reciben WhatsApp
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Nota: el ID de la Google Sheet (SHEET_ID) y los datos por cliente (nombre, direccion,
# precios, etc.) no son variables de entorno hoy: estan hardcodeados en cada nodo de
# Google Sheets del flow, o viven en la hoja "Configuracion" para la version multi-tenant.
# Reemplazar manualmente al clonar este template para un cliente nuevo.
