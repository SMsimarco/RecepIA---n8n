      "parameters": {
        "jsCode": "const d = $('Preparar Cambio').first().json;\nreturn [{ json: { resultado: 'Turno cambiado correctamente. Nuevo turno: *' + d.fecha_nueva + ' a las ' + d.hora_nueva + 'hs* (' + d.servicio + '). El turno del ' + d.fecha_actual + ' fue cancelado.' } }];"
