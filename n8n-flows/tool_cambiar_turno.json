      "name": "Leer Turnos",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 300],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "1vK8h8c8prheB8_KE7nwl6e4SblGoeALs_jE-vkgv5ho", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Turnos", "mode": "name" },
